[gemini]
# 联系Li_18727107073购买
api_key = YOUR_API_KEY_HERE

# Base URL 固定为“线路”下拉选择的三条显性线路（默认香港专线），不再支持通过 config.ini 覆盖。

# 最大并发工作线程数（建议 4-8，根据你的机器性能调整）
# 主要影响本地 CPU 侧的解码/处理并发度
max_workers = 4

# 网络并发上限（同时发起的网络请求数量上限，范围 1-8）
# 建议：
# - 稳定服务商/内网环境：4
# - 不稳定服务商/代理/VPN：2-3（降低请求雪崩概率）
network_workers_cap = 4

# Edge KV 预检（生图前的白名单校验）
# 关闭仅用于本地调试，线上强烈建议保持开启
kv_auth_enabled = true
# KV 校验接口地址，默认使用提供的 Edge Function
kv_auth_endpoint = https://apicha.yfeng.wang/api/check
# 可选：为 KV 校验接口附加认证信息（将作为 Bearer Token 发送）
kv_auth_token =
# 超时时间（秒），过大将拖慢生成体验，建议 5-10
kv_auth_timeout_seconds = 8
# 是否在 5xx/超时时放行（默认开启，可改为 false 禁止放行；放行也不会写入缓存）
kv_auth_fail_open_on_5xx = true
# 如需跳过 TLS 验证（自签证书或调试场景），设置为 true
kv_auth_disable_ssl_verify = false
